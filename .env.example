# 서버 전용. VITE_ 접두사를 붙이지 마세요.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
PORT=8787
# false: 하나의 전체화면 음성 키오스크 실행
BROWSER_HEADLESS=false
JEV_MIN_CONFIDENCE=0.5
# false: 계획으로 대상이 정해진 클릭은 JEV 재확인 생략(화면 변경·장바구니 검증은 유지)
JEV_VERIFY_STEPS=true
# 품절 메뉴 이름(쉼표 구분). 예: 딸기라떼,녹차라떼
SOLD_OUT=

# ElevenLabs: Speech to Text와 Text to Speech 권한이 필요합니다.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
